@page
@model HRMS.Pages.ImageGallerySetupModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HRMS - @Model.PageTitle</title>
    <link rel="stylesheet" href="/css/style.css?v=10" />
</head>
<body>
    @await Html.PartialAsync("_AppHeader", Model.PageTitle)

    <main class="container">
        @if (!string.IsNullOrEmpty(Model.AlertMessage))
        {
            <div class="alert alert-@Model.AlertType">@Model.AlertMessage</div>
        }

        <div class="card">
            <div class="card-header">
                <h2>@(Model.Input.GalleryImageID > 0 ? "Edit Gallery Image" : "Add Gallery Image")</h2>
            </div>
            <form method="post" asp-page-handler="Save" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="galleryImageID" value="@Model.Input.GalleryImageID" />
                <div class="card-body">
                    <div class="form-grid">
                        <div class="form-group">
                            <label>ID</label>
                            <input type="text" class="form-control" value="@(Model.Input.GalleryImageID > 0 ? Model.Input.GalleryImageID.ToString() : "Auto")" readonly />
                        </div>
                        <div class="form-group">
                            <label>Title <span class="required">*</span></label>
                            <input type="text" name="title" class="form-control" value="@Model.Input.Title" maxlength="150" />
                        </div>
                        <div class="form-group">
                            <label>Sort Order</label>
                            <input type="number" name="sortOrder" class="form-control" value="@Model.Input.SortOrder" min="0" />
                        </div>
                        <div class="form-group">
                            <label>Status</label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="isActive" value="true" @(Model.Input.IsActive ? "checked" : "") />
                                Active
                            </label>
                        </div>
                        <div class="form-group full-width">
                            <label>Description / Caption</label>
                            <textarea name="description" class="form-control" rows="3" maxlength="500">@Model.Input.Description</textarea>
                        </div>
                        <div class="form-group full-width">
                            <label>Image @(Model.Input.GalleryImageID == 0 ? "(required)" : "(optional)")</label>
                            <input type="file" name="imageFile" class="form-control" accept=".png,.jpg,.jpeg,.webp,.gif" />
                            <small style="color:var(--text-muted);">PNG, JPG, JPEG, WEBP, or GIF — shown on the home page slider</small>
                            @if (!string.IsNullOrWhiteSpace(Model.Input.ImagePath))
                            {
                                <div style="margin-top:.75rem;">
                                    <img src="@Model.Input.ImagePath" alt="@Model.Input.Title" style="max-height:120px; border-radius:8px; border:1px solid var(--border);" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">@(Model.Input.GalleryImageID > 0 ? "Update Image" : "Save Image")</button>
                    <a href="/ImageGallerySetup" class="btn btn-secondary">Clear</a>
                    <a href="/Home" class="btn btn-secondary">View Home Page</a>
                </div>
            </form>
        </div>

        <div class="card mt-4">
            <div class="card-header"><h2>Gallery Images</h2></div>
            <div class="card-body table-responsive">
                <table class="data-table">
                    <thead class="grid-header">
                        <tr>
                            <th>Preview</th>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Sort</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Records.Count == 0)
                        {
                            <tr class="empty-row"><td colspan="6">No gallery images found. Add images to display them on the home page slider.</td></tr>
                        }
                        else
                        {
                            foreach (var item in Model.Records)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                        {
                                            <img src="@item.ImagePath" alt="@item.Title" style="height:48px; width:80px; object-fit:cover; border-radius:4px;" />
                                        }
                                    </td>
                                    <td>@item.GalleryImageID</td>
                                    <td>@item.Title</td>
                                    <td>@item.SortOrder</td>
                                    <td><span class="badge @(item.IsActive ? "badge-success" : "badge-danger")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                                    <td class="actions-col">
                                        <a class="btn-icon btn-edit" href="/ImageGallerySetup?editId=@item.GalleryImageID" title="Edit">Edit</a>
                                        <form method="post" asp-page-handler="Delete" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="deleteId" value="@item.GalleryImageID" />
                                            <button type="submit" class="btn-icon btn-delete" title="Remove">X</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
    @await Html.PartialAsync("_AppFooter")
</body>
</html>
