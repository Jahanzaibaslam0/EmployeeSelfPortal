@model string

@inject HRMS.Services.AuthService Auth
@inject HRMS.Services.PermissionService Perms
@inject HRMS.Services.EmployeeProfileAccessService ProfileAccess

<header class="app-header">

    <div class="app-brand-band">

        <a href="/Home" class="app-logo" aria-label="HRMS Home">
            <img src="/images/gb-logo.png" alt="Ghazi Brothers" class="app-logo-img" />
        </a>

        <div class="app-title-block">

            <a href="/Home" class="brand-link">HRMS</a>

            <div class="app-subtitle">Human Resource Management System</div>

        </div>

        <div class="navbar-right">

            <span class="page-title">@Model</span>

            @if (Auth.IsLoggedIn)

            {

                <span class="user-info">

                    @Auth.CurrentUsername

                    @if (Auth.IsAdmin) { <span class="badge badge-warning" style="font-size:.65rem; padding:1px 6px;">Admin</span> }
                    else if (ProfileAccess.IsEndUser()) { <span class="badge badge-info" style="font-size:.65rem; padding:1px 6px;">End User</span> }

                </span>

                <a href="/Login?handler=Logout" class="btn btn-secondary" style="padding:3px 12px; font-size:.78rem; margin-right:.5rem;">Logout</a>

            }

            <span id="clock" class="clock"></span>

        </div>

    </div>

    <nav class="app-nav">

        <a href="/Home" class="nav-link nav-link--icon" title="Home">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1L1 7h2v6h4V9h2v4h4V7h2L8 1z"/></svg>
            Home
        </a>

        @if (Auth.IsAdmin || Perms.CanRead("Dashboard"))
        {
        <a href="/Dashboard" class="nav-link">Dashboard</a>
        }

        <a href="/UserProfile" class="nav-link">My Profile</a>

        @if (ProfileAccess.CanAccessMyDocuments())
        {
        <a href="/MyDocuments" class="nav-link">My Documents</a>
        }

        @if (ProfileAccess.CanAccessEmployeeCard())
        {
        <a href="/EmployeeCard" class="nav-link">ID Card</a>
        }

        @if (Perms.CanRead("LeaveMaster"))
        {
        <a href="/LeaveMaster" class="nav-link">Leave</a>
        }

        @if (Perms.CanShowMasterNavMenu())
        {
        <div class="nav-menu">
            <button type="button" class="nav-menu-button" data-menu="master">
                Master <span class="nav-caret">▾</span>
            </button>
            <div class="nav-menu-content">
                @if (ProfileAccess.HasFullEmployeeMasterAccess())
                {
                <a href="/EmployeeMaster">Employee Master</a>
                }
                @if (Perms.CanRead("PositionMaster"))
                {
                <a href="/PositionMaster">Position Master</a>
                }
                @if (Perms.CanRead("CustomerMaster"))
                {
                <a href="/CustomerMaster">Customer Master</a>
                }
                @if (Perms.CanRead("VendorMaster"))
                {
                <a href="/VendorMaster">Vendor Master</a>
                }
                @if (Perms.CanRead("ContactMaster"))
                {
                <a href="/ContactMaster">Contact Master</a>
                }
                @if (Perms.CanRead("ProductMaster"))
                {
                <a href="/ProductMaster">Product Master</a>
                }
                @if (Perms.CanRead("InvoiceMaster"))
                {
                <a href="/InvoiceMaster">Invoice Master</a>
                }
                @if (Perms.CanRead("PurchaseOrderMaster"))
                {
                <a href="/PurchaseOrderMaster">Purchase Order</a>
                }
                @if (Perms.CanRead("SalesOrderMaster"))
                {
                <a href="/SalesOrderMaster">Sales Order</a>
                }
                @if (Perms.CanRead("InventoryMaster"))
                {
                <a href="/InventoryMaster">Inventory</a>
                }
                @if (Perms.CanRead("TaskMaster"))
                {
                <a href="/TaskMaster">Task Management</a>
                }
            </div>
        </div>
        }

        @if (Perms.CanRead("QuickLinks"))
        {
        <a href="/QuickLinks" class="nav-link">Quick Links</a>
        }

        @if (Auth.IsAdmin || Perms.CanRead("Setup"))
        {
        <a href="/Setup" class="nav-link nav-link--icon" title="Setup &amp; Configuration">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M13.5 8.5c0-.3 0-.5-.1-.8l1.7-1.3-1.5-2.6-2 .7c-.4-.3-.8-.6-1.3-.8L10 1.5H7l-.3 2.2c-.5-.2-.9-.5-1.3-.8l-2-.7-1.5 2.6 1.7 1.3c-.1.3-.1.5-.1.8s0 .5.1.8l-1.7 1.3 1.5 2.6 2-.7c.4.3.8.6 1.3.8L7 14.5h3l.3-2.2c.5-.2.9-.5 1.3-.8l2 .7 1.5-2.6-1.7-1.3c.1-.3.1-.5.1-.8zm-5 2c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
            Setup
        </a>
        }

    </nav>

</header>

@await Html.PartialAsync("_NotificationPopup")

<script>
    (function initSharedClock() {
        function tick() {
            var el = document.getElementById('clock');
            if (!el) return;
            var now = new Date();
            el.textContent = now.toLocaleDateString('en-PK', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) + '  ' + now.toLocaleTimeString('en-PK');
        }
        tick();
        setInterval(tick, 1000);

        var currentPath = window.location.pathname.toLowerCase();

        document.querySelectorAll('.app-nav a').forEach(function (link) {
            var href = (link.getAttribute('href') || '').toLowerCase();
            if (href === currentPath) {
                link.classList.add('active');
            }
        });

        var setupPaths = [
            '/divisionsetup', '/businesssegmentsetup', '/businessunitsetup', '/workforcesegmentsetup',
            '/unitsetup', '/wingsetup', '/gendersetup', '/religionsetup', '/nationalitysetup', '/languagesetup',
            '/banksetup', '/bankgroupsetup', '/costcentersetup', '/skillsetup', '/unitofmeasuresetup',
            '/currencysetup', '/legalentitysetup', '/salesteamsetup',
            '/worklocationtypesetup', '/workarrangementsetup', '/extensionsetup',
            '/citysetup', '/provincesetup', '/salesgroupsetup',
            '/departmentsetup', '/regionsetup', '/locationsetup', '/softwarelinksetup',
            '/notificationsetup', '/memorandumsetup', '/imagegallerysetup',
            '/gradesetup', '/employmenttypesetup', '/designationlevelsetup', '/titlesetup', '/employmentstatussetup',
            '/benefitsetup', '/benefitentitlementsetup', '/expensecategorysetup', '/bloodgroupsetup',
            '/workercategorysetup', '/jobsetup', '/workerlocationsetup', '/documenttypesetup', '/leavecategorysetup',
            '/modeofdeliverysetup', '/methodofpaymentsetup', '/customergroupsetup',
            '/termsofpaymentsetup', '/customerclasssetup', '/billpreferencesetup',
            '/taxgroupsetup', '/fbrstatussetup',
            '/productnaturesetup', '/inventorytypesetup', '/itemregisteredsetup', '/brandcodesetup', '/brandgroupsetup',
            '/productgroupsetup', '/productsalesgroupsetup', '/itemgroupsetup', '/salescategorysetup',
            '/productdivisionsetup', '/productteamsetup', '/hscodesetup',
            '/usersetup', '/userrightssetup', '/auditreport', '/setup'
        ];

        var masterPaths = [
            '/employeemaster', '/positionmaster', '/customermaster', '/vendormaster',
            '/contactmaster', '/productmaster', '/invoicemaster', '/purchaseordermaster', '/salesordermaster',
            '/inventorymaster', '/goodsreceiptmaster', '/goodsissuemaster', '/inventoryreport',
            '/taskmaster'
        ];

        if (currentPath === '/' || currentPath === '/index' || currentPath === '/home') {
            var home = document.querySelector('.app-nav a[href="/Home"]');
            if (home) home.classList.add('active');
        }
        else if (masterPaths.indexOf(currentPath) >= 0) {
            var masterBtn = document.querySelector('[data-menu="master"]');
            if (masterBtn) masterBtn.classList.add('active');
        }
        else if (setupPaths.indexOf(currentPath) >= 0) {
            var setupLink = document.querySelector('.app-nav a[href="/Setup"]');
            if (setupLink) setupLink.classList.add('active');
        }
    }());
</script>

