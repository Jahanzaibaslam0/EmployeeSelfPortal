@page
@model HRMS.Pages.SalesOrderMasterModel
@{
    Layout = null;
    var pageTitle = Model.ShowForm
        ? (Model.EditMode ? "Edit Sales Order" : "New Sales Order")
        : "Sales Order";
    var isDraft = Model.Input.OrderStatus.Equals("Draft", StringComparison.OrdinalIgnoreCase);
    var isSubmitted = Model.Input.OrderStatus.Equals("Submitted", StringComparison.OrdinalIgnoreCase);
    var canEdit = Model.ShowForm && !Model.IsReadOnly;
    var canSubmit = canEdit && isDraft;
    var canCancel = Model.EditMode && (isDraft || isSubmitted);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HRMS – @pageTitle</title>
    <link rel="stylesheet" href="/css/style.css?v=10" />
    <style>
        .so-list-header { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.75rem; }
        .so-list-header .right-controls { display:flex; align-items:center; gap:.6rem; }
        .form-breadcrumb { display:flex; align-items:center; gap:.75rem; margin-bottom:1rem; padding:.5rem .75rem; background:#f9fafb; border:1px solid #e5e7eb; border-radius:6px; }
        .form-breadcrumb .crumb-sep { color:#9ca3af; }
        .form-breadcrumb .crumb-current { font-weight:600; color:#111827; }
        .readonly-field { background:#f3f4f6; color:#374151; cursor:not-allowed; }
        .so-totals-row { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:1.5rem; margin-top:1rem; padding:.75rem 1rem; background:#f9fafb; border:1px solid #e5e7eb; border-radius:6px; }
        .so-totals-row .total-item { text-align:right; }
        .so-totals-row .total-item .label { font-size:.78rem; color:#6b7280; display:block; }
        .so-totals-row .total-item .value { font-weight:600; color:#374151; }
        .so-totals-row .total-item.grand .value { font-size:1.25rem; font-weight:700; color:var(--gb-blue); }
        #soItemTable input.form-control, #soItemTable select.form-control { font-size:.78rem; padding:4px 6px; min-width:70px; }
        #soItemTable .item-line-net { font-size:.85rem; }
        .status-badge { display:inline-block; padding:2px 10px; border-radius:12px; font-size:.75rem; font-weight:600; }
        .status-draft { background:#f3f4f6; color:#374151; }
        .status-submitted { background:#dbeafe; color:#1e40af; }
        .status-approved { background:#dcfce7; color:#166534; }
        .status-cancelled { background:#fee2e2; color:#991b1b; }
        .history-table { font-size:.82rem; }
        .history-table td { padding:.35rem .5rem; }
    </style>
</head>
<body>

    @await Html.PartialAsync("_AppHeader", pageTitle)

    <main class="container">

        @if (!string.IsNullOrEmpty(Model.AlertMessage))
        {
            <div class="alert alert-@Model.AlertType">@Model.AlertMessage</div>
        }

        @if (!Model.ShowForm)
        {
            <div class="card">
                <div class="card-header so-list-header">
                    <h2>Sales Order List</h2>
                    <div class="right-controls">
                        <input type="text" id="txtSearch" class="form-control" style="width:260px"
                               placeholder="Search SO / customer / status…"
                               onkeyup="searchSOTable(this.value)" />
                        <a href="/SalesOrderMaster?newSO=true" class="btn btn-primary">+ New Sales Order</a>
                    </div>
                </div>
                <div class="card-body table-responsive">
                    <table class="data-table" id="soTable">
                        <thead class="grid-header">
                            <tr>
                                <th>#</th>
                                <th>SO Number</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th>Status</th>
                                <th>Grand Total</th>
                                <th>Lines</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.SalesOrders.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" style="text-align:center; padding:2rem; color:#6b7280;">
                                        No sales orders found.
                                        <br />
                                        <a href="/SalesOrderMaster?newSO=true" class="btn btn-primary" style="margin-top:.75rem;">+ Add First Sales Order</a>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int rowNum = 0;
                                foreach (var so in Model.SalesOrders)
                                {
                                    rowNum++;
                                    var statusClass = so.OrderStatus.ToLowerInvariant() switch
                                    {
                                        "submitted" => "status-submitted",
                                        "approved" => "status-approved",
                                        "cancelled" => "status-cancelled",
                                        _ => "status-draft"
                                    };
                                    <tr class="@(rowNum % 2 == 0 ? "grid-alt-row" : "grid-row")">
                                        <td>@rowNum</td>
                                        <td><code style="font-size:.75rem;background:#f1f5f9;padding:.1rem .4rem;border-radius:4px;">@so.SalesOrderCode</code></td>
                                        <td>@so.SalesOrderDate.ToString("dd MMM yyyy")</td>
                                        <td>@so.CustomerName</td>
                                        <td><span class="status-badge @statusClass">@so.OrderStatus</span></td>
                                        <td>@so.GrandTotal.ToString("N2")</td>
                                        <td>@so.LineCount</td>
                                        <td style="white-space:nowrap;">
                                            <a href="/SalesOrderMaster?editId=@so.SalesOrderID" class="btn btn-secondary" style="padding:3px 12px; font-size:.8rem;">@(so.OrderStatus == "Cancelled" || so.OrderStatus == "Approved" ? "View" : "Edit")</a>
                                            @if (so.OrderStatus == "Draft")
                                            {
                                                <form method="post" asp-page-handler="Delete" style="display:inline"
                                                      onsubmit="return confirm('Delete this sales order?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="deleteId" value="@so.SalesOrderID" />
                                                    <button type="submit" class="btn btn-danger" style="padding:3px 10px; font-size:.8rem;">Delete</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer">
                    <span class="record-count">Total Records: @Model.SalesOrders.Count</span>
                </div>
            </div>
        }
        else
        {
            <div class="form-breadcrumb">
                <a href="/SalesOrderMaster" class="btn btn-secondary" style="padding:4px 14px;">&#8592; Back to List</a>
                <span class="crumb-sep">/</span>
                <span class="crumb-current">@(Model.EditMode ? "Edit Sales Order" : "New Sales Order")</span>
                @if (Model.EditMode)
                {
                    var sc = Model.Input.OrderStatus.ToLowerInvariant() switch
                    {
                        "submitted" => "status-submitted",
                        "approved" => "status-approved",
                        "cancelled" => "status-cancelled",
                        _ => "status-draft"
                    };
                    <span class="crumb-sep">–</span>
                    <span style="color:#4b5563; font-size:.9rem;">@Model.Input.SalesOrderCode</span>
                    <span class="status-badge @sc">@Model.Input.OrderStatus</span>
                }
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>@(Model.EditMode ? (Model.IsReadOnly ? "View Sales Order" : "Edit Sales Order") : "Add Sales Order")</h2>
                </div>

                <form method="post" id="soForm" novalidate
                      data-readonly="@(Model.IsReadOnly ? "true" : "false")"
                      onsubmit="return prepareSOPayload();">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="SalesOrderID" value="@Model.Input.SalesOrderID" />
                    <input type="hidden" name="EditMode" value="@(Model.EditMode ? "true" : "false")" />
                    <input type="hidden" name="ItemsJson" id="ItemsJson" />
                    <input type="hidden" name="OrderStatus" value="@Model.Input.OrderStatus" />
                    <input type="hidden" name="TotalQty" id="TotalQty" value="@Model.Input.TotalQty" />
                    <input type="hidden" name="TotalTax" id="TotalTax" value="@Model.Input.TotalTax" />
                    <input type="hidden" name="TotalDiscount" id="TotalDiscount" value="@Model.Input.TotalDiscount" />
                    <input type="hidden" name="GrandTotal" id="GrandTotal" value="@Model.Input.GrandTotal" />

                    <div class="card-body">
                        <div class="form-grid">

                            <div class="form-group full-width">
                                <h3 class="form-section-title">Sales Order Header</h3>
                            </div>

                            <div class="form-group">
                                <label>Sales Order Number</label>
                                <input type="text" name="SalesOrderCode" class="form-control readonly-field"
                                       value="@Model.Input.SalesOrderCode" readonly />
                                <small class="field-hint">Auto-generated (e.g. SO000001)</small>
                            </div>

                            <div class="form-group">
                                <label>Sales Order Date <span class="required">*</span></label>
                                <input type="date" name="SalesOrderDate" id="txtSODate" class="form-control"
                                       value="@Model.Input.SalesOrderDate" required @(Model.IsReadOnly ? "readonly" : "") />
                            </div>

                            <div class="form-group">
                                <label>Customer Code <span class="required">*</span></label>
                                <select name="CustomerID" id="ddlCustomer" class="form-control" required @(Model.IsReadOnly ? "disabled" : "")>
                                    <option value="">-- Select Customer --</option>
                                    @foreach (var c in Model.Customers)
                                    {
                                        <option value="@c.Id" selected="@(c.Id == Model.Input.CustomerID)">@c.Name</option>
                                    }
                                </select>
                                @if (Model.IsReadOnly)
                                {
                                    <input type="hidden" name="CustomerID" value="@Model.Input.CustomerID" />
                                }
                            </div>

                            <div class="form-group">
                                <label>Customer Name</label>
                                <input type="text" name="CustomerName" id="txtCustomerName" class="form-control readonly-field"
                                       value="@Model.Input.CustomerName" readonly maxlength="200" />
                            </div>

                            <div class="form-group full-width">
                                <label>Remarks</label>
                                <textarea name="Remarks" class="form-control" rows="2" maxlength="500"
                                          @(Model.IsReadOnly ? "readonly" : "")>@Model.Input.Remarks</textarea>
                            </div>

                        </div>

                        <div class="form-group full-width mt-4">
                            <div class="card">
                                <div class="card-header space-between">
                                    <h2>Order Lines</h2>
                                    @if (canEdit)
                                    {
                                        <button type="button" class="btn btn-secondary" onclick="addSOItemRow()">+ Add Line</button>
                                    }
                                </div>
                                <div class="card-body table-responsive">
                                    <table class="data-table" id="soItemTable">
                                        <thead class="grid-header">
                                            <tr>
                                                <th>Product Code</th>
                                                <th>Product Description</th>
                                                <th>Quantity</th>
                                                <th>Unit Price</th>
                                                <th>Tax Amount</th>
                                                <th>Discount Amount</th>
                                                <th>Net Amount</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="so-totals-row">
                            <div class="total-item">
                                <span class="label">Total Quantity</span>
                                <span class="value" id="lblTotalQty">@Model.Input.TotalQty</span>
                            </div>
                            <div class="total-item">
                                <span class="label">Total Tax</span>
                                <span class="value" id="lblTotalTax">@Model.Input.TotalTax</span>
                            </div>
                            <div class="total-item">
                                <span class="label">Total Discount</span>
                                <span class="value" id="lblTotalDiscount">@Model.Input.TotalDiscount</span>
                            </div>
                            <div class="total-item grand">
                                <span class="label">Grand Total</span>
                                <span class="value" id="lblGrandTotal">@Model.Input.GrandTotal</span>
                            </div>
                        </div>

                        @if (Model.EditMode && Model.OrderHistory.Count > 0)
                        {
                            <div class="form-group full-width mt-4">
                                <div class="card">
                                    <div class="card-header">
                                        <h2>Order History</h2>
                                    </div>
                                    <div class="card-body table-responsive">
                                        <table class="data-table history-table">
                                            <thead class="grid-header">
                                                <tr>
                                                    <th>Date / Time</th>
                                                    <th>Action</th>
                                                    <th>From</th>
                                                    <th>To</th>
                                                    <th>User</th>
                                                    <th>Remarks</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var h in Model.OrderHistory)
                                                {
                                                    <tr>
                                                        <td>@h.ActionAt.ToString("dd MMM yyyy HH:mm")</td>
                                                        <td>@h.ActionType</td>
                                                        <td>@h.FromStatus</td>
                                                        <td>@h.ToStatus</td>
                                                        <td>@h.ActionByUsername</td>
                                                        <td>@h.Remarks</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="card-footer" style="display:flex; gap:.75rem; flex-wrap:wrap;">
                        @if (canEdit)
                        {
                            <button type="submit" class="btn btn-primary">@(Model.EditMode ? "Save Changes" : "Save Draft")</button>
                        }
                        @if (canSubmit)
                        {
                            <button type="submit" formaction="?handler=Submit" formmethod="post"
                                    class="btn btn-primary" style="background:var(--gb-blue);"
                                    onclick="return prepareSOSubmit();">
                                Submit Order
                            </button>
                        }
                        @if (canCancel)
                        {
                            <form method="post" asp-page-handler="Cancel" style="display:inline"
                                  onsubmit="return confirm('Cancel this sales order?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cancelId" value="@Model.Input.SalesOrderID" />
                                <button type="submit" class="btn btn-danger">Cancel Order</button>
                            </form>
                        }
                        <a href="/SalesOrderMaster" class="btn btn-secondary">@(Model.IsReadOnly ? "Close" : "Back")</a>
                    </div>
                </form>
            </div>

            <script type="application/json" id="productLookupData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Products))</script>
            <script type="application/json" id="initialSOItemsData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ItemRecords))</script>
            <script src="/js/salesorder.js?v=1"></script>
        }
    </main>

    @await Html.PartialAsync("_AppFooter")

    @if (!Model.ShowForm)
    {
        <script>
            function searchSOTable(q) {
                q = (q || '').toLowerCase();
                document.querySelectorAll('#soTable tbody tr').forEach(function (r) {
                    if (r.querySelector('td[colspan]')) return;
                    r.style.display = r.innerText.toLowerCase().includes(q) ? '' : 'none';
                });
            }
        </script>
    }
</body>
</html>
