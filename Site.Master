<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="HRMS.SiteMaster" %>
<%@ Register Src="~/Controls/AppHeader.ascx" TagPrefix="hrms" TagName="AppHeader" %>
<%@ Register Src="~/Controls/AppSidebar.ascx" TagPrefix="hrms" TagName="AppSidebar" %>
<%@ Register Src="~/Controls/AppFooter.ascx" TagPrefix="hrms" TagName="AppFooter" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ghazi Workstation - <asp:Literal ID="litTitle" runat="server" /></title>
    <link rel="stylesheet" href="<%= ResolveUrl("~/css/style.css") %>?v=18" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body class="ws-body">
<form id="form1" runat="server">
    <hrms:AppHeader ID="appHeader" runat="server" />
    <div class="ws-shell">
        <hrms:AppSidebar ID="appSidebar" runat="server" />
        <div class="ws-main">
            <main class="container">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
            <hrms:AppFooter ID="appFooter" runat="server" />
        </div>
    </div>
</form>
<script src="<%= ResolveUrl("~/js/confirm-delete.js") %>"></script>
<asp:ContentPlaceHolder ID="scripts" runat="server" />
<script src="<%= ResolveUrl("~/js/app.js") %>?v=2026111801"></script>
</body>
</html>
